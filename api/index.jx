<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#050608">
  <title>HACKER F5 — F5 CORE</title>

  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    :root {
      --bg: #050608;
      --panel: rgba(12, 15, 20, .88);
      --panel2: rgba(18, 22, 29, .92);
      --line: rgba(255,255,255,.08);
      --text: #f4f7fb;
      --muted: #87909d;
      --red: #ff1744;
      --red2: #ff4d6d;
      --green: #00e676;
      --blue: #42a5f5;
      --yellow: #ffd740;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(circle at 50% 20%, rgba(255,23,68,.10), transparent 30%),
        radial-gradient(circle at 20% 80%, rgba(66,165,245,.05), transparent 30%),
        var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      overflow: hidden;
    }

    button,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
      color: inherit;
    }

    /* BACKGROUND */

    .grid {
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: .22;
      background-image:
        linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
      background-size: 38px 38px;
      mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
    }

    .particles {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 2px;
      height: 2px;
      background: rgba(255,255,255,.55);
      border-radius: 50%;
      animation: float 8s linear infinite;
    }

    @keyframes float {
      from {
        transform: translateY(110vh);
        opacity: 0;
      }
      20% { opacity: .8; }
      80% { opacity: .8; }
      to {
        transform: translateY(-10vh);
        opacity: 0;
      }
    }

    /* APP */

    .app {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 900px;
      height: 100vh;
      margin: auto;
      display: flex;
      flex-direction: column;
    }

    /* HEADER */

    header {
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      border-bottom: 1px solid var(--line);
      background: rgba(5,6,8,.78);
      backdrop-filter: blur(18px);
      position: relative;
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .crown {
      font-size: 25px;
    }

    .brand-title {
      font-weight: 900;
      letter-spacing: 1.5px;
      font-size: 15px;
    }

    .brand-sub {
      font-size: 9px;
      color: var(--muted);
      margin-top: 2px;
      letter-spacing: 1px;
    }

    .header-actions {
      display: flex;
      gap: 7px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: rgba(255,255,255,.055);
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
      font-size: 17px;
    }

    .icon-btn:active {
      transform: scale(.92);
    }

    /* STATUS */

    .statusbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 14px;
      font-size: 10px;
      color: var(--muted);
      letter-spacing: .8px;
      border-bottom: 1px solid rgba(255,255,255,.04);
    }

    .online {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .online-dot {
      width: 7px;
      height: 7px;
      background: var(--green);
      border-radius: 50%;
      box-shadow: 0 0 10px rgba(0,230,118,.7);
    }

    /* CORE */

    .core-zone {
      position: relative;
      height: 275px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .core-zone.action {
      animation: actionPulse .7s ease;
    }

    @keyframes actionPulse {
      0% { transform: scale(1); }
      35% { transform: scale(1.015); }
      100% { transform: scale(1); }
    }

    .orbit {
      position: absolute;
      border: 1px solid rgba(255,23,68,.22);
      border-radius: 50%;
      animation: rotate 18s linear infinite;
    }

    .orbit.one {
      width: 180px;
      height: 180px;
    }

    .orbit.two {
      width: 230px;
      height: 230px;
      border-color: rgba(255,255,255,.07);
      animation-duration: 26s;
      animation-direction: reverse;
    }

    .orbit.three {
      width: 275px;
      height: 275px;
      border-color: rgba(66,165,245,.07);
      animation-duration: 34s;
    }

    @keyframes rotate {
      to { transform: rotate(360deg); }
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 14px var(--red);
    }

    .orbit::before {
      top: 10px;
      left: 50%;
    }

    .orbit::after {
      right: 20px;
      bottom: 30px;
      background: var(--blue);
      box-shadow: 0 0 14px var(--blue);
    }

    .core {
      position: relative;
      width: 128px;
      height: 128px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle, rgba(255,23,68,.20), rgba(8,10,13,.96) 62%);
      border: 1px solid rgba(255,23,68,.55);
      box-shadow:
        0 0 30px rgba(255,23,68,.14),
        inset 0 0 35px rgba(255,23,68,.10);
      z-index: 2;
    }

    .core::before {
      content: "";
      position: absolute;
      inset: 9px;
      border-radius: 50%;
      border: 1px dashed rgba(255,255,255,.18);
      animation: rotate 8s linear infinite;
    }

    .core::after {
      content: "";
      position: absolute;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      border: 1px solid rgba(255,23,68,.55);
      animation: corePulse 2s ease-in-out infinite;
    }

    @keyframes corePulse {
      0%,100% {
        transform: scale(.85);
        opacity: .4;
      }
      50% {
        transform: scale(1.15);
        opacity: 1;
      }
    }

    .core-content {
      position: relative;
      z-index: 3;
      text-align: center;
    }

    .core-f5 {
      font-size: 34px;
      font-weight: 1000;
      letter-spacing: 4px;
    }

    .core-label {
      font-size: 8px;
      letter-spacing: 2px;
      color: var(--muted);
      margin-top: 4px;
    }

    .node {
      position: absolute;
      width: 28px;
      height: 28px;
      border: 1px solid var(--line);
      background: rgba(8,10,13,.88);
      border-radius: 9px;
      display: grid;
      place-items: center;
      font-size: 12px;
      z-index: 4;
      box-shadow: 0 0 15px rgba(0,0,0,.3);
    }

    .node.n1 { top: 18px; left: 22%; }
    .node.n2 { top: 25px; right: 19%; }
    .node.n3 { bottom: 28px; left: 19%; }
    .node.n4 { bottom: 22px; right: 20%; }

    .node.active {
      border-color: rgba(255,23,68,.6);
      box-shadow: 0 0 18px rgba(255,23,68,.15);
    }

    /* TASK */

    .task {
      margin: 0 14px 10px;
      min-height: 46px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: rgba(13,16,21,.76);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      backdrop-filter: blur(12px);
    }

    .task-icon {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      display: grid;
      place-items: center;
      background: rgba(255,23,68,.10);
      color: var(--red2);
    }

    .task-info {
      flex: 1;
      min-width: 0;
    }

    .task-title {
      font-size: 11px;
      font-weight: 800;
    }

    .task-detail {
      font-size: 9px;
      color: var(--muted);
      margin-top: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* CHAT */

    .chat {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 6px 14px 150px;
      scroll-behavior: smooth;
    }

    .welcome {
      text-align: center;
      margin: 8px 0 18px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.5;
    }

    .message {
      display: flex;
      margin: 9px 0;
      animation: appear .25s ease;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      justify-content: flex-end;
    }

    .bubble {
      max-width: 86%;
      padding: 11px 13px;
      border-radius: 16px;
      font-size: 13px;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .message.ai .bubble {
      background: rgba(18,22,29,.9);
      border: 1px solid var(--line);
      border-top-left-radius: 5px;
    }

    .message.user .bubble {
      background: linear-gradient(135deg, #9f0c2d, #d61542);
      border-bottom-right-radius: 5px;
      color: white;
    }

    .bubble code {
      display: block;
      overflow-x: auto;
      padding: 10px;
      margin-top: 8px;
      background: #050608;
      border-radius: 10px;
      font-family: monospace;
      font-size: 11px;
    }

    /* QUICK ACTIONS */

    .quick {
      display: flex;
      gap: 7px;
      overflow-x: auto;
      padding: 4px 14px 8px;
      scrollbar-width: none;
    }

    .quick::-webkit-scrollbar {
      display: none;
    }

    .quick button {
      flex-shrink: 0;
      padding: 8px 11px;
      border-radius: 11px;
      background: rgba(255,255,255,.045);
      border: 1px solid var(--line);
      font-size: 10px;
      color: #dbe0e7;
    }

    .quick button:active {
      transform: scale(.95);
      background: rgba(255,23,68,.12);
    }

    /* INPUT */

    .composer-wrap {
      position: fixed;
      z-index: 20;
      left: 50%;
      bottom: 0;
      transform: translateX(-50%);
      width: 100%;
      max-width: 900px;
      padding: 8px 12px 12px;
      background: linear-gradient(
        to top,
        rgba(5,6,8,1) 70%,
        rgba(5,6,8,.7),
        transparent
      );
    }

    .composer {
      border: 1px solid rgba(255,255,255,.11);
      border-radius: 18px;
      background: rgba(14,17,22,.95);
      box-shadow: 0 -10px 30px rgba(0,0,0,.3);
      padding: 8px;
      backdrop-filter: blur(18px);
    }

    .tools-row {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .tool {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(255,255,255,.05);
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
      font-size: 15px;
    }

    .tool:active {
      transform: scale(.9);
    }

    textarea {
      width: 100%;
      min-height: 42px;
      max-height: 110px;
      resize: none;
      border: 0;
      outline: 0;
      background: transparent;
      color: white;
      padding: 8px 4px;
      font-size: 14px;
    }

    textarea::placeholder {
      color: #646d78;
    }

    .send {
      margin-left: auto;
      width: 42px;
      height: 42px;
      border-radius: 13px;
      background: linear-gradient(135deg, #ff1744, #b50931);
      box-shadow: 0 0 18px rgba(255,23,68,.22);
      font-size: 17px;
    }

    .send:active {
      transform: scale(.91);
    }

    /* PANELS */

    .overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      background: rgba(0,0,0,.62);
      backdrop-filter: blur(7px);
      display: none;
      align-items: flex-end;
    }

    .overlay.show {
      display: flex;
    }

    .panel {
      width: 100%;
      max-width: 900px;
      margin: auto auto 0;
      max-height: 82vh;
      overflow-y: auto;
      border: 1px solid var(--line);
      border-bottom: 0;
      border-radius: 22px 22px 0 0;
      background: #0c0f14;
      padding: 16px;
      animation: panelUp .25s ease;
    }

    @keyframes panelUp {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .panel-title {
      font-weight: 900;
      font-size: 17px;
    }

    .close {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(255,255,255,.06);
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .menu-item {
      min-height: 72px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.035);
      padding: 9px;
      text-align: left;
    }

    .menu-item .emoji {
      font-size: 21px;
      display: block;
      margin-bottom: 6px;
    }

    .menu-item strong {
      font-size: 10px;
    }

    .menu-item small {
      display: block;
      color: var(--muted);
      font-size: 8px;
      margin-top: 3px;
    }

    .history-empty {
      color: var(--muted);
      text-align: center;
      padding: 35px 10px;
      font-size: 12px;
    }

    .history-item {
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 12px;
      margin-bottom: 8px;
      background: rgba(255,255,255,.035);
      cursor: pointer;
    }

    .history-item strong {
      font-size: 12px;
    }

    .history-item small {
      display: block;
      color: var(--muted);
      margin-top: 5px;
      font-size: 9px;
    }

    .setting {
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 13px;
      margin-bottom: 9px;
      background: rgba(255,255,255,.035);
    }

    .setting-title {
      font-size: 12px;
      font-weight: 800;
    }

    .setting-desc {
      font-size: 9px;
      color: var(--muted);
      margin-top: 5px;
    }

    .danger {
      color: #ff6682;
    }

    /* LOADING */

    .typing {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .typing span {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--red);
      animation: typing .8s infinite alternate;
    }

    .typing span:nth-child(2) { animation-delay: .2s; }
    .typing span:nth-child(3) { animation-delay: .4s; }

    @keyframes typing {
      from { opacity: .25; transform: translateY(0); }
      to { opacity: 1; transform: translateY(-3px); }
    }

    @media (min-width: 700px) {
      .core-zone {
        height: 320px;
      }

      .core {
        width: 150px;
        height: 150px;
      }

      .core-f5 {
        font-size: 40px;
      }
    }
  </style>
</head>

<body>

<div class="grid"></div>
<div class="particles" id="particles"></div>

<div class="app">

  <header>
    <div class="brand">
      <div class="crown">👑</div>
      <div>
        <div class="brand-title">HACKER F5</div>
        <div class="brand-sub">F5 CORE EXPERIENCE</div>
      </div>
    </div>

    <div class="header-actions">
      <button class="icon-btn" onclick="newConversation()">＋</button>
      <button class="icon-btn" onclick="openPanel('history')">◷</button>
      <button class="icon-btn" onclick="openPanel('settings')">⚙</button>
    </div>
  </header>

  <div class="statusbar">
    <div class="online">
      <span class="online-dot"></span>
      <span id="systemStatus">F5 CORE • READY</span>
    </div>
    <span id="contextStatus">CONTEXT: CHAT</span>
  </div>

  <section class="core-zone" id="coreZone">

    <div class="orbit one"></div>
    <div class="orbit two"></div>
    <div class="orbit three"></div>

    <div class="node n1 active">AI</div>
    <div class="node n2">⌁</div>
    <div class="node n3">▣</div>
    <div class="node n4">⌘</div>

    <div class="core">
      <div class="core-content">
        <div class="core-f5">F5</div>
        <div class="core-label">NEURAL CORE</div>
      </div>
    </div>

  </section>

  <div class="task">
    <div class="task-icon" id="taskIcon">✦</div>
    <div class="task-info">
      <div class="task-title" id="taskTitle">HACKER F5 READY</div>
      <div class="task-detail" id="taskDetail">
        Système prêt • conversation active
      </div>
    </div>
  </div>

  <main class="chat" id="chat">

    <div class="welcome">
      <strong>Lab HACKF5 ACTIVATE 🇦🇱</strong><br>
      HACKF5 ✍️ (by - king 👑 Franck)
    </div>

    <div class="message ai">
      <div class="bubble">
        HACKER F5 est prêt.<br>
        Pose ta question ou sélectionne un module ci-dessous.
      </div>
    </div>

  </main>

  <div class="quick">
    <button onclick="quickAction('Explique ce code et aide-moi à le corriger.')">💻 Code</button>
    <button onclick="quickAction('Analyse ce problème de cybersécurité dans un cadre défensif.')">🛡️ Cyber</button>
    <button onclick="quickAction('Recherche des informations actuelles sur ce sujet.')">🌐 Recherche</button>
    <button onclick="quickAction('Décode ce texte en utilisant les formats de décodage courants.')">🔐 Décoder</button>
    <button onclick="openPanel('tools')">＋ Outils</button>
  </div>

</div>

<!-- COMPOSER -->

<div class="composer-wrap">

  <div class="composer">

    <textarea
      id="input"
      placeholder="Écrire à HACKER F5..."
      rows="1"
      oninput="resizeInput(this)"
      onkeydown="handleKey(event)"
    ></textarea>

    <div class="tools-row">

      <button class="tool" onclick="openPanel('tools')" title="Outils">＋</button>

      <button class="tool" onclick="selectFile()" title="Fichier">📎</button>

      <button class="tool" onclick="startVoice()" title="Voix">🎙️</button>

      <button class="tool" onclick="speakLast()" title="Lire">🔊</button>

      <button class="send" onclick="sendMessage()" title="Envoyer">➤</button>

    </div>

  </div>

</div>

<input
  type="file"
  id="fileInput"
  hidden
  multiple
  onchange="handleFiles(this.files)"
>

<!-- TOOLS PANEL -->

<div class="overlay" id="toolsPanel" onclick="closePanelOutside(event,'toolsPanel')">

  <div class="panel">

    <div class="panel-head">
      <div class="panel-title">F5 COMMAND CENTER</div>
      <button class="close" onclick="closePanel('toolsPanel')">✕</button>
    </div>

    <div class="menu-grid">

      <button class="menu-item" onclick="setMode('CHAT')">
        <span class="emoji">👑</span>
        <strong>Chat IA</strong>
        <small>Conversation</small>
      </button>

      <button class="menu-item" onclick="setMode('CODE')">
        <span class="emoji">💻</span>
        <strong>Code</strong>
        <small>Créer / analyser</small>
      </button>

      <button class="menu-item" onclick="setMode('CYBER')">
        <span class="emoji">🛡️</span>
        <strong>Cyber</strong>
        <small>Défensif</small>
      </button>

      <button class="menu-item" onclick="setMode('SEARCH')">
        <span class="emoji">🌐</span>
        <strong>Recherche</strong>
        <small>Web</small>
      </button>

      <button class="menu-item" onclick="setMode('DECODE')">
        <span class="emoji">🔐</span>
        <strong>Décodage</strong>
        <small>Analyse données</small>
      </button>

      <button class="menu-item" onclick="setMode('FILE')">
        <span class="emoji">📎</span>
        <strong>Fichiers</strong>
        <small>Importer</small>
      </button>

      <button class="menu-item" onclick="setMode('PDF')">
        <span class="emoji">📄</span>
        <strong>PDF</strong>
        <small>Documents</small>
      </button>

      <button class="menu-item" onclick="setMode('DOCX')">
        <span class="emoji">📝</span>
        <strong>Word</strong>
        <small>DOCX</small>
      </button>

      <button class="menu-item" onclick="setMode('IMAGE')">
        <span class="emoji">🖼️</span>
        <strong>Image</strong>
        <small>Génération</small>
      </button>

      <button class="menu-item" onclick="setMode('VIDEO')">
        <span class="emoji">🎬</span>
        <strong>Vidéo</strong>
        <small>Génération</small>
      </button>

      <button class="menu-item" onclick="setMode('MUSIC')">
        <span class="emoji">🎵</span>
        <strong>Musique</strong>
        <small>Création</small>
      </button>

      <button class="menu-item" onclick="startVoice()">
        <span class="emoji">🎙️</span>
        <strong>Voix IA</strong>
        <small>Parler</small>
      </button>

      <button class="menu-item" onclick="downloadConversation()">
        <span class="emoji">📥</span>
        <strong>Télécharger</strong>
        <small>Conversation</small>
      </button>

    </div>

  </div>

</div>

<!-- HISTORY -->

<div class="overlay" id="historyPanel" onclick="closePanelOutside(event,'historyPanel')">

  <div class="panel">

    <div class="panel-head">
      <div class="panel-title">CONVERSATIONS</div>
      <button class="close" onclick="closePanel('historyPanel')">✕</button>
    </div>

    <div id="historyList"></div>

  </div>

</div>

<!-- SETTINGS -->

<div class="overlay" id="settingsPanel" onclick="closePanelOutside(event,'settingsPanel')">

  <div class="panel">

    <div class="panel-head">
      <div class="panel-title">PARAMÈTRES F5</div>
      <button class="close" onclick="closePanel('settingsPanel')">✕</button>
    </div>

    <div class="setting">
      <div class="setting-title">👤 Compte</div>
      <div class="setting-desc">
        Interface préparée pour la connexion et les comptes.
      </div>
    </div>

    <div class="setting">
      <div class="setting-title">🧠 Mémoire conversationnelle</div>
      <div class="setting-desc">
        Les conversations sont conservées localement dans cette version.
      </div>
    </div>

    <div class="setting">
      <div class="setting-title">🔊 Voix</div>
      <div class="setting-desc">
        Utilise la synthèse vocale disponible sur ton téléphone.
      </div>
    </div>

    <div class="setting">
      <div class="setting-title">⚡ F5 CORE</div>
      <div class="setting-desc">
        Interface mobile optimisée et animations légères.
      </div>
    </div>

    <div
      class="setting danger"
      onclick="clearHistory()"
      style="cursor:pointer"
    >
      <div class="setting-title">🗑️ Effacer l'historique</div>
      <div class="setting-desc">
        Supprimer les conversations enregistrées sur cet appareil.
      </div>
    </div>

  </div>

</div>

<script>

  const state = {
    conversationId: null,
    mode: "CHAT",
    messages: [],
    history: JSON.parse(localStorage.getItem("f5_history") || "[]")
  };

  const chat = document.getElementById("chat");
  const input = document.getElementById("input");

  /* PARTICLES */

  function createParticles() {

    const container = document.getElementById("particles");

    for (let i = 0; i < 28; i++) {

      const p = document.createElement("div");

      p.className = "particle";

      p.style.left = Math.random() * 100 + "%";
      p.style.animationDelay = (Math.random() * 8) + "s";
      p.style.animationDuration = (6 + Math.random() * 8) + "s";

      container.appendChild(p);
    }
  }

  createParticles();

  /* INPUT */

  function resizeInput(el) {

    el.style.height = "auto";

    el.style.height =
      Math.min(el.scrollHeight, 110) + "px";
  }

  function handleKey(event) {

    if (event.key === "Enter" && !event.shiftKey) {

      event.preventDefault();

      sendMessage();
    }
  }

  /* MESSAGE */

  function addMessage(role, content) {

    const wrapper = document.createElement("div");

    wrapper.className =
      "message " + (role === "user" ? "user" : "ai");

    const bubble = document.createElement("div");

    bubble.className = "bubble";

    bubble.textContent = content;

    wrapper.appendChild(bubble);

    chat.appendChild(wrapper);

    chat.scrollTop = chat.scrollHeight;

    state.messages.push({
      role,
      content
    });
  }

  function addTyping() {

    const wrapper = document.createElement("div");

    wrapper.className = "message ai";
    wrapper.id = "typingMessage";

    wrapper.innerHTML = `
      <div class="bubble">
        <div class="typing">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    `;

    chat.appendChild(wrapper);

    chat.scrollTop = chat.scrollHeight;
  }

  function removeTyping() {

    const el =
      document.getElementById("typingMessage");

    if (el) el.remove();
  }

  /* SEND */

  async function sendMessage() {

    const text = input.value.trim();

    if (!text) return;

    addMessage("user", text);

    input.value = "";
    input.style.height = "42px";

    activateCore();

    setTask(
      "PROCESSING REQUEST",
      "HACKER F5 analyse la demande..."
    );

    addTyping();

    try {

      const response = await fetch("/api/chat", {

        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        body: JSON.stringify({

          messages: [
            {
              role: "user",
              content: text
            }
          ],

          conversationId:
            state.conversationId

        })

      });

      const data = await response.json();

      removeTyping();

      if (!response.ok || !data.ok) {

        throw new Error(
          data.error ||
          "Erreur serveur."
        );

      }

      if (data.conversationId) {

        state.conversationId =
          data.conversationId;
      }

      const answer =
        data.answer ||
        "Aucune réponse reçue.";

      addMessage("assistant", answer);

      setTask(
        "F5 CORE • READY",
        "Réponse reçue • conversation active"
      );

      document.getElementById("systemStatus").textContent =
        "F5 CORE • READY";

      saveHistory();

    } catch (error) {

      removeTyping();

      const message =
        error?.message ||
        "Erreur inconnue.";

      addMessage(
        "assistant",
        "⚠️ Erreur HACKER F5 : " + message
      );

      setTask(
        "F5 CORE • ERROR",
        message
      );

      document.getElementById("systemStatus").textContent =
        "F5 CORE • ERROR";
    }
  }

  /* QUICK ACTION */

  function quickAction(text) {

    input.value = text;

    resizeInput(input);

    input.focus();
  }

  /* CORE ANIMATION */

  function activateCore() {

    const zone =
      document.getElementById("coreZone");

    zone.classList.remove("action");

    void zone.offsetWidth;

    zone.classList.add("action");

    document.getElementById("systemStatus").textContent =
      "F5 CORE • PROCESSING";
  }

  /* TASK STATUS */

  function setTask(title, detail) {

    document.getElementById("taskTitle").textContent =
      title;

    document.getElementById("taskDetail").textContent =
      detail;
  }

  /* MODES */

  function setMode(mode) {

    state.mode = mode;

    const names = {

      CHAT: [
        "👑",
        "CHAT",
        "Conversation IA"
      ],

      CODE: [
        "💻",
        "CODE",
        "Analyse et développement"
      ],

      CYBER: [
        "🛡️",
        "CYBER",
        "Analyse défensive"
      ],

      SEARCH: [
        "🌐",
        "SEARCH",
        "Recherche web"
      ],

      DECODE: [
        "🔐",
        "DECODE",
        "Analyse et décodage"
      ],

      FILE: [
        "📎",
        "FILE",
        "Analyse de fichiers"
      ],

      PDF: [
        "📄",
        "PDF",
        "Documents PDF"
      ],

      DOCX: [
        "📝",
        "DOCX",
        "Documents Word"
      ],

      XLSX: [
        "📊",
        "XLSX",
        "Tableurs Excel"
      ],

      PPTX: [
        "📽️",
        "PPTX",
        "Présentations"
      ],

      IMAGE: [
        "🖼️",
        "IMAGE",
        "Génération d'images"
      ],

      VIDEO: [
        "🎬",
        "VIDEO",
        "Génération vidéo"
      ],

      MUSIC: [
        "🎵",
        "MUSIC",
        "Génération musicale"
      ]

    };

    const info =
      names[mode] || names.CHAT;

    document.getElementById("taskIcon").textContent =
      info[0];

    document.getElementById("taskTitle").textContent =
      "MODE " + info[1];

    document.getElementById("taskDetail").textContent =
      info[2];

    document.getElementById("contextStatus").textContent =
      "CONTEXT: " + info[1];

    closeAllPanels();
  }

  /* NEW CONVERSATION */

  function newConversation() {

    state.conversationId = null;
    state.messages = [];

    chat.innerHTML = `
      <div class="welcome">
        <strong>Nouvelle session F5</strong><br>
        HACKF5 ✍️ (by - king 👑 Franck)
      </div>
    `;

    setTask(
      "NEW CONVERSATION",
      "Nouvelle session prête."
    );

    document.getElementById("systemStatus").textContent =
      "F5 CORE • READY";
  }

  /* HISTORY */

  function saveHistory() {

    const firstUser =
      state.messages.find(
        m => m.role === "user"
      );

    if (!firstUser) return;

    const item = {

      id: Date.now(),

      title:
        firstUser.content.slice(0, 55),

      date:
        new Date().toLocaleString(),

      messages:
        [...state.messages]

    };

    state.history.unshift(item);

    state.history =
      state.history.slice(0, 30);

    localStorage.setItem(
      "f5_history",
      JSON.stringify(state.history)
    );
  }

  function renderHistory() {

    const list =
      document.getElementById("historyList");

    if (!state.history.length) {

      list.innerHTML = `
        <div class="history-empty">
          Aucune conversation enregistrée.
        </div>
      `;

      return;
    }

    list.innerHTML = "";

    state.history.forEach(item => {

      const div =
        document.createElement("div");

      div.className = "history-item";

      div.innerHTML = `
        <strong>${escapeHtml(item.title)}</strong>
        <small>${escapeHtml(item.date)}</small>
      `;

      div.onclick = () =>
        loadHistory(item.id);

      list.appendChild(div);

    });
  }

  function loadHistory(id) {

    const item =
      state.history.find(
        h => h.id === id
      );

    if (!item) return;

    state.messages =
      [...item.messages];

    state.conversationId = null;

    chat.innerHTML = "";

    item.messages.forEach(message => {

      addMessage(
        message.role,
        message.content
      );

    });

    closeAllPanels();
  }

  function clearHistory() {

    state.history = [];

    localStorage.removeItem("f5_history");

    renderHistory();

    closePanel("settingsPanel");
  }

  /* FILES */

  function selectFile() {

    document.getElementById(
      "fileInput"
    ).click();
  }

  function handleFiles(files) {

    if (!files || !files.length) return;

    const names =
      Array.from(files)
        .map(file => file.name)
        .join(", ");

    addMessage(
      "user",
      "📎 Fichier(s) sélectionné(s) : " + names
    );

    setMode("FILE");

    setTask(
      "FILE INTAKE",
      files.length + " fichier(s) sélectionné(s)"
    );

    /*
     * L'interface est prête.
     * Le branchement réel de l'analyse
     * des fichiers sera ajouté au backend.
     */
  }

  /* VOICE */

  function startVoice() {

    const SpeechRecognition =
      window.SpeechRecognition ||
      window.webkitSpeechRecognition;

    if (!SpeechRecognition) {

      addMessage(
        "assistant",
        "🎙️ La reconnaissance vocale n'est pas disponible dans ce navigateur."
      );

      return;
    }

    const recognition =
      new SpeechRecognition();

    recognition.lang = "fr-FR";

    recognition.interimResults = false;

    recognition.maxAlternatives = 1;

    setTask(
      "VOICE REACTOR",
      "Écoute en cours..."
    );

    recognition.start();

    recognition.onresult = event => {

      const text =
        event.results[0][0].transcript;

      input.value = text;

      resizeInput(input);

      setTask(
        "VOICE READY",
        "Message vocal capturé"
      );
    };

    recognition.onerror = () => {

      setTask(
        "VOICE ERROR",
        "Impossible de capturer la voix"
      );
    };
  }

  /* TEXT TO SPEECH */

  function speakLast() {

    const last =
      [...state.messages]
        .reverse()
        .find(
          message =>
            message.role === "assistant"
        );

    if (!last) return;

    if (!("speechSynthesis" in window)) {
      return;
    }

    window.speechSynthesis.cancel();

    const utterance =
      new SpeechSynthesisUtterance(
        last.content
      );

    utterance.lang = "fr-FR";

    window.speechSynthesis.speak(
      utterance
    );
  }

  /* DOWNLOAD */

  function downloadConversation() {

    const text =
      state.messages
        .map(message => {

          const who =
            message.role === "user"
              ? "MOI"
              : "HACKER F5";

          return (
            who +
            ":\n" +
            message.content
          );

        })
        .join(
          "\n\n----------------\n\n"
        );

    const blob =
      new Blob(
        [text],
        {
          type:
            "text/plain;charset=utf-8"
        }
      );

    const url =
      URL.createObjectURL(blob);

    const a =
      document.createElement("a");

    a.href = url;

    a.download =
      "HACKER-F5-conversation.txt";

    document.body.appendChild(a);

    a.click();

    a.remove();

    URL.revokeObjectURL(url);
  }

  /* PANELS */

  function openPanel(type) {

    closeAllPanels();

    if (type === "tools") {

      document
        .getElementById("toolsPanel")
        .classList.add("show");
    }

    if (type === "history") {

      renderHistory();

      document
        .getElementById("historyPanel")
        .classList.add("show");
    }

    if (type === "settings") {

      document
        .getElementById("settingsPanel")
        .classList.add("show");
    }
  }

  function closePanel(id) {

    document
      .getElementById(id)
      .classList.remove("show");
  }

  function closeAllPanels() {

    document
      .querySelectorAll(".overlay")
      .forEach(panel =>
        panel.classList.remove("show")
      );
  }

  function closePanelOutside(event, id) {

    if (event.target.id === id) {

      closePanel(id);
    }
  }

  /* ESCAPE HTML */

  function escapeHtml(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

</script>

</body>
</html>
